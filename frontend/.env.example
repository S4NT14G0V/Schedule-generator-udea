# URL del backend (Express + Scraper)
VITE_API_URL=http://localhost:3001

# Modo de datos simulados (Mock Data)
# - true: Carga materias y grupos de prueba offline de forma instantánea sin necesidad de ejecutar el backend ni scraping.
# - false: Consulta los datos reales mediante el servicio de scraping del backend.
VITE_USE_MOCK_DATA=true
