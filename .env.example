# ==========================================
# Configuración del Backend (API & Scraper)
# ==========================================
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# ==========================================
# Configuración del Frontend (Vite)
# (Copiar estos valores a frontend/.env si se corre en local)
# ==========================================
VITE_API_URL=http://localhost:3001
# true: usa datos de prueba instantáneos (offline) | false: web scraping real
VITE_USE_MOCK_DATA=true
